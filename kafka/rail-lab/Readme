>>> spark.sql("""
... WITH train_delay AS (
...     SELECT
...         tr.train_id,
...         tr.train_type,
...         tr.zone,
...         ROUND(SUM(t.delay_minutes)/60,0) AS total_delay_hrs
...     FROM trips t
...     JOIN trains tr
...     ON t.train_id = tr.train_id
...     GROUP BY
...         tr.train_id,
...         tr.train_type,
...         tr.zone
... )
... SELECT *
... FROM (
...     SELECT
...         *,
...         ROW_NUMBER() OVER (
...             PARTITION BY zone
...             ORDER BY total_delay_hrs DESC
...         ) AS row_num,
... 
...         RANK() OVER (
...             PARTITION BY zone
...             ORDER BY total_delay_hrs DESC
...         ) AS rnk,
... 
...         DENSE_RANK() OVER (
...             PARTITION BY zone
...             ORDER BY total_delay_hrs DESC
...              ) AS dense_rnk
... 
...     FROM train_delay
... )
... WHERE rnk <= 3
... ORDER BY zone, rnk
... """).show(15)
