vboxuser@Ubuntu2:~/CDAC_Big_Data/airflow/telecom-usage$ cat sql/01_create_raw_table.sql
DROP TABLE IF EXISTS telecom_usage_raw;

CREATE TABLE telecom_usage_raw (
    usage_id STRING,
    customer_id STRING,
    plan STRING,
    call_minutes INT,
    sms_count INT,
    data_gb DOUBLE,
    usage_date DATE,
    circle STRING
)
ROW FORMAT DELIMITED
FIELDS TERMINATED BY ','
STORED AS TEXTFILE
TBLPROPERTIES (
    "skip.header.line.count"="1"
);
vboxuser@Ubuntu2:~/CDAC_Big_Data/airflow/telecom-usage$ cat sql/02_load_raw_table.sql
LOAD DATA INPATH '/user/vboxuser/telecom_usage/raw/telecom_usage.csv'
INTO TABLE telecom_usage_raw;
vboxuser@Ubuntu2:~/CDAC_Big_Data/airflow/telecom-usage$ cat sql/03_create_final_table.sql
DROP TABLE IF EXISTS telecom_usage_final;

CREATE TABLE telecom_usage_final
AS
SELECT
    usage_id,
    customer_id,
    plan,
    call_minutes,
    sms_count,
    data_gb,
    usage_date,
    circle,
    CASE
        WHEN data_gb >= 10 THEN 'HIGH'
        ELSE 'NORMAL'
    END AS usage_category
FROM telecom_usage_raw;
