vboxuser@Ubuntu2:~/CDAC_Big_Data/airflow/telecom-usage$ cat ~/airflow/dags/telecom_usage_dag.py
from datetime import datetime

from airflow import DAG
from airflow.providers.standard.operators.bash import BashOperator


# ============================================================
# PROJECT PATHS
# ============================================================

PROJECT_HOME = "/home/vboxuser/CDAC_Big_Data/airflow/telecom-usage"

SQL_DIR = f"{PROJECT_HOME}/sql"

CSV_FILE = f"{PROJECT_HOME}/telecom_usage.csv"


# ============================================================
# HDFS PATH
# ============================================================

HDFS_DIR = "/user/vboxuser/telecom_usage/raw"

HDFS_FILE = f"{HDFS_DIR}/telecom_usage.csv"


# ============================================================
# DEFAULT ARGUMENTS
# ============================================================

default_args = {
    "owner": "data-engineering",
    "retries": 1,
}


# ============================================================
# DAG
# ============================================================

with DAG(
    dag_id="telecom_usage_etl",
    default_args=default_args,
    start_date=datetime(2026, 10, 1),
    schedule=None,
    catchup=False,
    tags=["telecom", "hdfs", "hive", "etl"],
) as dag:

    # ========================================================
    # TASK 1: UPLOAD CSV TO HDFS
    # ========================================================

    upload_raw_data_to_hdfs = BashOperator(
        task_id="upload_raw_data_to_hdfs",

        bash_command=f"""
        export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
        export HADOOP_HOME=/usr/local/hadoop
        export HIVE_HOME=/usr/local/hive
        export PATH=$JAVA_HOME/bin:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$HIVE_HOME/bin:$PATH

        echo "========================================="
        echo "Uploading telecom CSV to HDFS"
        echo "========================================="

        hdfs dfs -mkdir -p {HDFS_DIR}

        hdfs dfs -put -f {CSV_FILE} {HDFS_FILE}

        echo "HDFS contents:"

        hdfs dfs -ls {HDFS_DIR}
        """,
    )


    # ========================================================
    # TASK 2: CREATE HIVE RAW TABLE
    # ========================================================

    create_hive_raw_table = BashOperator(
        task_id="create_hive_raw_table",

        bash_command=f"""
        export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
        export HADOOP_HOME=/usr/local/hadoop
        export HIVE_HOME=/usr/local/hive
        export PATH=$JAVA_HOME/bin:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$HIVE_HOME/bin:$PATH

        echo "========================================="
        echo "Creating Hive raw table"
        echo "========================================="

        beeline -u "jdbc:hive2://localhost:10001" \
        -f {SQL_DIR}/01_create_raw_table.sql
        """,
    )


    # ========================================================
    # TASK 3: LOAD DATA INTO HIVE RAW TABLE
    # ========================================================

    load_hive_raw_table = BashOperator(
        task_id="load_hive_raw_table",

        bash_command=f"""
        export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
        export HADOOP_HOME=/usr/local/hadoop
        export HIVE_HOME=/usr/local/hive
        export PATH=$JAVA_HOME/bin:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$HIVE_HOME/bin:$PATH

        echo "========================================="
        echo "Loading data into Hive raw table"
        echo "========================================="

        beeline -u "jdbc:hive2://localhost:10001" \
        -f {SQL_DIR}/02_load_raw_table.sql
        """,
    )


    # ========================================================
    # TASK 4: CREATE FINAL TABLE + TRANSFORMATION
    # ========================================================

    create_hive_final_table = BashOperator(
        task_id="create_hive_final_table",

        bash_command=f"""
        export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
        export HADOOP_HOME=/usr/local/hadoop
        export HIVE_HOME=/usr/local/hive
        export PATH=$JAVA_HOME/bin:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$HIVE_HOME/bin:$PATH

        echo "========================================="
        echo "Creating Hive final table"
        echo "========================================="

        beeline -u "jdbc:hive2://localhost:10001" \
        -f {SQL_DIR}/03_create_final_table.sql
        """,
    )


    # ========================================================
    # TASK 5: VERIFY FINAL OUTPUT
    # ========================================================

    verify_final_output = BashOperator(
        task_id="verify_final_output",

        bash_command="""
        export JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
        export HADOOP_HOME=/usr/local/hadoop
        export HIVE_HOME=/usr/local/hive
        export PATH=$JAVA_HOME/bin:$HADOOP_HOME/bin:$HADOOP_HOME/sbin:$HIVE_HOME/bin:$PATH

        echo "========================================="
        echo "VERIFYING RAW TABLE"
        echo "========================================="

        beeline -u "jdbc:hive2://localhost:10001" -e "
        SELECT COUNT(*) AS raw_count
        FROM telecom_usage_raw;
        "

        echo "========================================="
        echo "VERIFYING FINAL TABLE"
        echo "========================================="

        beeline -u "jdbc:hive2://localhost:10001" -e "
        SELECT
            usage_id,
            customer_id,
            plan,
            data_gb,
            circle,
            usage_category
        FROM telecom_usage_final;
        "

        echo "========================================="
        echo "VERIFYING USAGE CATEGORIES"
        echo "========================================="

        beeline -u "jdbc:hive2://localhost:10001" -e "
        SELECT
            usage_category,
            COUNT(*) AS count
        FROM telecom_usage_final
        GROUP BY usage_category;
        "
        """,
    )


    # ========================================================
    # TASK DEPENDENCIES
    # ========================================================

    (
        upload_raw_data_to_hdfs
        >> create_hive_raw_table
        >> load_hive_raw_table
        >> create_hive_final_table
        >> verify_final_output
    )
